index 0000000..1a81b8e
--- /dev/null
+++ b/acestep/ui/gradio/p3_control_test.py
@@ -0,0 +1,74 @@
+"""Tests for P3rzible status tracking and the Stop button (p3_control)."""
+import threading
+import time
+import unittest
+from unittest.mock import MagicMock, patch
+
+import gradio as gr
+
+from acestep.ui.gradio import p3_control
+
+
+def _fake_generation(steps, progress=gr.Progress()):
+    """Stand-in for the Generate handler: reports progress, sleeps per step, yields a result."""
+    for i in range(steps):
+        progress(i / steps, desc=f"Diffusion step {i + 1}/{steps}")
+        time.sleep(0.05)
+    yield "done"
+
+
+class StoppableTests(unittest.TestCase):
+    """Behaviour of the stoppable() wrapper, request_stop() and the status text."""
+
+    def setUp(self):
+        self.patches = [patch.object(p3_control.gr, "Info", MagicMock()),
+                        patch.object(p3_control, "free_memory", MagicMock())]
+        for p in self.patches:
+            p.start()
+
+    def tearDown(self):
+        for p in self.patches:
+            p.stop()
+
+    def test_finishes_normally_and_reports_steps(self):
+        """A run that is not stopped yields its result and records progress text."""
+        seen = []
+        wrapped = p3_control.stoppable(_fake_generation)
+        progress = MagicMock(side_effect=lambda *a, **k: seen.append(p3_control.status_text()))
+        self.assertEqual(list(wrapped(3, progress)), ["done"])
+        self.assertTrue(any("Diffusion step 2/3" in s for s in seen))
+        self.assertIn("Finished", p3_control.status_text())
+
+    def test_stop_interrupts_running_generation(self):
+        """Stop raises inside the worker thread; the run ends early with the skip result."""
+        wrapped = p3_control.stoppable(_fake_generation)
+        out = {}
+
+        def run():
+            out["items"] = list(wrapped(200, MagicMock()))
+
+        worker = threading.Thread(target=run)
+        worker.start()
+        time.sleep(0.3)
+        p3_control.request_stop()
+        worker.join(timeout=5)
+        self.assertFalse(worker.is_alive(), "generation did not stop")
+        self.assertEqual(len(out["items"]), 1)
+        self.assertEqual(len(out["items"][0]), p3_control.STOP_OUTPUTS)
+        self.assertIn("Stopped", p3_control.status_text())
+
+    def test_stop_when_idle_only_frees_memory(self):
+        """Pressing Stop with nothing running is harmless."""
+        text = p3_control.request_stop()
+        self.assertIn("Nothing is running", text)
+        p3_control.free_memory.assert_called()
+
+    def test_wrapper_keeps_signature_for_gradio(self):
+        """Gradio inspects the handler signature; the wrapper must expose the original one."""
+        import inspect
+        wrapped = p3_control.stoppable(_fake_generation)
+        self.assertIn("progress", inspect.signature(wrapped).parameters)
+
+
+if __name__ == "__main__":
+    unittest.main()
