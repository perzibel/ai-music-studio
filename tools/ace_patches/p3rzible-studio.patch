new file mode 100644
index 0000000..f462019
--- /dev/null
+++ b/acestep/ui/gradio/p3_control.py
@@ -0,0 +1,222 @@
+"""P3rzible Music Studio additions: live "current step" status, a Stop button that really stops a
+generation and frees its memory, and memory cleanup between generations.
+
+How Stop works: the engine has no interrupt hook, so Stop raises GenerationStopped inside the thread that
+runs the generation (PyThreadState_SetAsyncExc). It fires at the next Python step of whatever phase is
+running (LM planning, a diffusion step, an audio-decode chunk), unwinds normally (model offload context
+managers run their cleanup), and the wrapper then clears caches so RAM/VRAM is released.
+"""
+from __future__ import annotations
+
+import ctypes
+import functools
+import gc
+import inspect
+import threading
+import time
+
+import gradio as gr
+from loguru import logger
+
+STOP_OUTPUTS = 55  # number of outputs of the Generate event (same count its own error path yields)
+
+
+class GenerationStopped(BaseException):
+    """Raised inside the generation thread when the user presses Stop.
+
+    BaseException (like KeyboardInterrupt) so the engine's broad ``except Exception`` handlers
+    can't swallow it and carry on; ``finally`` blocks and context managers still run.
+    """
+
+
+_lock = threading.Lock()
+_state = {"thread": None, "running": False, "stopping": False, "started": 0.0,
+          "value": 0.0, "desc": "", "last": "Idle - ready to generate."}
+
+
+def _mem_text() -> str:
+    try:
+        import psutil
+        proc = psutil.Process()
+        used = proc.memory_info().private / 1024 ** 3 if hasattr(proc.memory_info(), "private") \
+            else proc.memory_info().rss / 1024 ** 3
+        sysm = psutil.virtual_memory()
+        text = f"App memory {used:.1f} GB · PC RAM free {sysm.available / 1024 ** 3:.1f} GB"
+    except Exception:
+        text = ""
+    try:
+        import torch
+        if torch.cuda.is_available():
+            text += f" · GPU {torch.cuda.memory_allocated() / 1024 ** 3:.1f} GB"
+    except Exception:
+        pass
+    return text
+
+
+class _ProgressProxy:
+    """Wraps gr.Progress: records every update for the status bar, then forwards it."""
+
+    def __init__(self, inner):
+        self._inner = inner
+
+    def __call__(self, value=None, desc=None, *args, **kwargs):
+        with _lock:
+            if isinstance(value, (int, float)):
+                _state["value"] = float(value)
+            if desc:
+                _state["desc"] = str(desc)
+        try:
+            return self._inner(value, desc, *args, **kwargs)
+        except GenerationStopped:
+            raise
+        except Exception:  # an unbound gr.Progress must never break a generation
+            return None
+
+    def __getattr__(self, name):
+        return getattr(self._inner, name)
+
+
+def begin(progress):
+    """Call at the start of a generation (in its thread). Returns the progress object to pass on."""
+    with _lock:
+        _state.update(thread=threading.get_ident(), running=True, stopping=False, started=time.time(),
+                      value=0.0, desc="Starting...")
+    return _ProgressProxy(progress)
+
+
+def end(outcome: str) -> None:
+    """Call when a generation finishes, fails or is stopped (in its thread)."""
+    with _lock:
+        tid = _state["thread"]
+        elapsed = time.time() - _state["started"] if _state["started"] else 0
+        _state.update(thread=None, running=False, stopping=False, value=0.0, desc="",
+                      last=f"{outcome} ({elapsed:.0f}s).")
+    if tid is not None:  # cancel a Stop that arrived too late to fire, so it can't hit unrelated work later
+        ctypes.pythonapi.PyThreadState_SetAsyncExc(ctypes.c_ulong(tid), None)
+    free_memory()
+
+
+def free_memory() -> None:
+    gc.collect()
+    try:
+        import torch
+        if torch.cuda.is_available():
+            torch.cuda.empty_cache()
+            torch.cuda.ipc_collect()
+            # CPU offload moves models RAM<->GPU every phase through pinned host buffers, which
+            # PyTorch caches and never returns on its own: this is what made RAM grow per run.
+            host_empty = getattr(torch._C, "_host_emptyCache", None)
+            if host_empty is not None:
+                host_empty()
+    except Exception as exc:  # cleanup must never break the UI
+        logger.warning("[p3] memory cleanup: {}", exc)
+
+
+def request_stop():
+    with _lock:
+        tid, running = _state["thread"], _state["running"]
+        if running and tid is not None:
+            _state["stopping"] = True
+            _state["desc"] = "Stopping... (finishing the current step)"
+    if not running or tid is None:  # status_text() takes the lock itself: call it outside
+        free_memory()
+        return status_text() + "\n\nNothing is running. Memory caches cleared."
+    ctypes.pythonapi.PyThreadState_SetAsyncExc(ctypes.c_ulong(tid), ctypes.py_object(GenerationStopped))
+    gr.Info("Stopping the generation and freeing memory...")
+    return status_text()
+
+
+RESTART_EXIT_CODE = 75  # studio/launch_app.py restarts the app at once on this code, without an error
+HIGH_MEMORY_GB = 26.0  # above this while idle, suggest a restart
+
+
+def request_restart():
+    """Exit the whole app process so the launcher restarts it: returns every byte of RAM and VRAM."""
+    import os
+    with _lock:
+        running = _state["running"]
+    if running:
+        return status_text() + "\n\nA generation is running: press Stop first, then Restart."
+    logger.info("[p3] restart requested by user")
+
+    def _exit_soon():
+        time.sleep(0.5)  # let this response reach the browser first
+        os._exit(RESTART_EXIT_CODE)
+
+    threading.Thread(target=_exit_soon, daemon=True).start()
+    return ("♻️ **Restarting the engine to free all memory...** Reload this page in about a minute "
+            "(the window on your desktop shows when it's ready).")
+
+
+def _app_memory_gb() -> float:
+    try:
+        import psutil
+        info = psutil.Process().memory_info()
+        return getattr(info, "private", info.rss) / 1024 ** 3
+    except Exception:
+        return 0.0
+
+
+def status_text() -> str:
+    with _lock:
+        s = dict(_state)
+    mem = _mem_text()
+    if s["running"]:
+        pct = int(round(s["value"] * 100))
+        mins, secs = divmod(int(time.time() - s["started"]), 60)
+        icon = "⏳ Stopping" if s["stopping"] else "▶️ Working"
+        return f"**{icon}: {s['desc'] or 'Working...'}** · {pct}% · {mins}:{secs:02d} elapsed  \n{mem}"
+    hint = ""
+    if _app_memory_gb() > HIGH_MEMORY_GB:
+        hint = "  \n⚠️ Memory is high: press **♻ Restart engine** to free it all before the next run."
+    return f"⏹️ {s['last']}  \n{mem}{hint}"
+
+
+def stoppable(fn):
+    """Decorate the Generate click handler (a generator): status tracking + Stop support.
+
+    Keeps fn's signature (Gradio reads it to inject gr.Progress), wraps that progress object so the
+    status bar sees every update, and turns a Stop into a clean "stopped" result instead of an error.
+    """
+    sig = inspect.signature(fn)
+
+    @functools.wraps(fn)
+    def wrapper(*args, **kwargs):
+        bound = sig.bind(*args, **kwargs)
+        bound.apply_defaults()
+        if "progress" in bound.arguments:
+            bound.arguments["progress"] = begin(bound.arguments["progress"])
+        else:
+            begin(None)
+        outcome = "Finished"
+        try:
+            yield from fn(*bound.args, **bound.kwargs)
+        except GenerationStopped:
+            outcome = "Stopped by you - memory freed"
+            logger.info("[p3] generation stopped by user")
+            gr.Info("Generation stopped. Memory has been freed.")
+            yield (gr.skip(),) * STOP_OUTPUTS
+        except BaseException:
+            outcome = "Failed - see the error message"
+            raise
+        finally:
+            end(outcome)
+
+    return wrapper
+
+
+def build_status_row():
+    """Status bar + Stop button, placed under the Generate button (must run inside gr.Blocks)."""
+    with gr.Row(equal_height=True):
+        with gr.Column(scale=18):
+            status = gr.Markdown(status_text(), elem_id="p3-status")
+        with gr.Column(scale=3, min_width=160):
+            stop_btn = gr.Button("⏹ Stop & free memory", variant="stop", elem_id="p3-stop-btn")
+            restart_btn = gr.Button("♻ Restart engine", variant="secondary", size="sm",
+                                    elem_id="p3-restart-btn")
+    timer = gr.Timer(1.0)
+    timer.tick(status_text, outputs=status, queue=False, show_progress="hidden")
+    # queue=False: must run immediately, not wait behind the generation it is stopping.
+    stop_btn.click(request_stop, outputs=status, queue=False, show_progress="hidden")
+    restart_btn.click(request_restart, outputs=status, queue=False, show_progress="hidden")
+    return status, stop_btn
